{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(xcodebuild:*)",
      "Bash(xcode-select:*)",
      "Bash(codesign:*)",
      "Bash(otool:*)",
      "Bash(file:*)",
      "Bash(plutil:*)",
      "Bash(system_profiler:*)",
      "Bash(ioreg:*)",
      "Bash(launchctl list:*)",
      "Bash(ps aux:*)"
