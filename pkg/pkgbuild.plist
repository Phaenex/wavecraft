<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <array>
    <dict>
      <key>RootRelativeBundlePath</key>      <string>Applications/Wavecraft.app</string>
      <key>BundleHasStrictIdentifier</key>   <false/>
      <!-- Was <true/> -- relocatable meant Installer resolved this component's actual install
           location by looking up the bundle ID in Launch Services' own (cached, not live)
           registration database, not by the RootRelativeBundlePath above. A leftover pre-rename
           "Background Music.app" (same bundle ID) was still registered there, so every install
           kept landing on that old path/name regardless of what preinstall did to clean it up
           first -- confirmed on a real install, see docs/LESSONS.md. false forces installation at
           the literal path above, every time, no bundle-ID lookup involved. -->
      <key>BundleIsRelocatable</key>         <false/>
      <key>BundleIsVersionChecked</key>      <false/>
      <key>BundleOverwriteAction</key>       <string>upgrade</string>
    </dict>
    <dict>
      <key>RootRelativeBundlePath</key>      <string>Library/Audio/Plug-Ins/HAL/Background Music Device.driver</string>
      <key>BundleHasStrictIdentifier</key>   <false/>
      <key>BundleIsRelocatable</key>         <false/>
      <key>BundleIsVersionChecked</key>      <false/>
      <key>BundleOverwriteAction</key>       <string>upgrade</string>
    </dict>
  </array>
</plist>

