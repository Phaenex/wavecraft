PATH=/bin:/sbin:/usr/bin:/usr/sbin; export PATH

# Earlier versions of this app installed as "Background Music.app" -- if that folder is still
# around and shares this app's bundle ID, remove it before the real payload installs. Otherwise
# pkgbuild's relocatable bundle handling (see pkg/pkgbuild.plist's BundleIsRelocatable/
# BundleOverwriteAction=upgrade for the app component) finds it via Launch Services *by bundle ID,
# not by path*, and upgrades its contents in place -- leaving the folder itself under its old name
# forever, even though everything inside (the executable, Info.plist's version string) correctly
# reports the new one. Confirmed the hard way: a real install did exactly this, and postinstall's
# own `open -b com.bearisdriving.BGM.App` (see its header comment, which already predicted this
# exact failure mode for "multiple copies") then launched the app from that stale path.
#
# Safe to just remove outright, not migrate: all of this app's persistent state (NSUserDefaults,
# window positions, TCC grants) is keyed by bundle ID, not by the app bundle's location on disk,
# so nothing is lost by removing the old folder and letting the new payload install fresh.
old_app_path="/Applications/Background Music.app"

if [ -d "$old_app_path" ]; then
    old_bundle_id="$(/usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" \
        "${old_app_path}/Contents/Info.plist" 2>/dev/null)"

    if [ "$old_bundle_id" = "com.bearisdriving.BGM.App" ]; then
        logger "Removing old-named app bundle at ${old_app_path} before install (bundle ID matches; \
same app, new name)."
        pkill -x "Wavecraft" 2>/dev/null || true
        pkill -x "Background Music" 2>/dev/null || true
        rm -rf "$old_app_path"
    fi
fi

# Show a warning if we can't find a safe dir to install BGMXPCHelper in. Should be very unlikely.
xpc_helper_path="$(bash safe_install_dir.sh -y)"

if [ "$(bash safe_install_dir.sh "$xpc_helper_path")" != "1" ]; then
    msg="We need to install a background helper service to ${xpc_helper_path}, but it may not "
    msg+="be secure to do so.\n\n"
    msg+="${xpc_helper_path} and all of its parent directories should be owned by 'root', with the "
    msg+="group 'wheel', and have permissions 755 (rwxr-xr-x). To fix it yourself first, run:\n"
    msg+="  sudo chown -R root:wheel \"${xpc_helper_path}\"\n"
    msg+="  sudo chmod -R 755 \"${xpc_helper_path}\"\n"
    msg+="then try installing again.\n\n"
    msg+="Wavecraft will still work if you decide to continue."

    if [ "$COMMAND_LINE_INSTALL" == "1" ]; then
        # logger alone lands in the system log, not anywhere a person running
        # `sudo installer -pkg ... -target /` from a terminal would actually see it -- echo it to
        # stderr too, so the message the GUI path shows in a dialog isn't silently dropped here.
        echo "WARNING: $msg" >&2
        logger "WARNING: $msg"
        exit 1
    else
        if ! osascript <<EOT
            tell application id "com.apple.systemuiserver"
                display alert "Warning" \
                    message "$msg" \
                    buttons {"Cancel", "Install Anyway"} \
                    default button "Cancel" \
                    cancel button "Cancel" \
                    as warning
            end tell
EOT
        then
            exit 1
        fi
    fi
fi

exit 0


